{
	"compilerOptions": {
		"allowJs": true,
		"checkJs": true,
		"lib": ["ES2022", "DOM", "DOM.Iterable"],
		"module": "ESNext",
		"moduleResolution": "Bundler",
		"noEmit": true,
		"skipLibCheck": true,
		"strict": true,
		"target": "ES2022",
		"types": []
	},
	"include": ["src/**/*.js", "src/**/*.ts"]
}
