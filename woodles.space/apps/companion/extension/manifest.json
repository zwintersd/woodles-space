{
  "manifest_version": 3,
  "name": "woodles",
  "short_name": "woodles",
  "version": "0.1.0",
  "description": "woodles.space in Chrome's side panel: keep what you find, see what's waiting, step away.",
  "minimum_chrome_version": "116",
  "incognito": "not_allowed",
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "action": {
    "default_title": "open woodles",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png"
    }
  },
  "side_panel": {
    "default_path": "panel.html"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "commands": {
    "open-companion": {
      "suggested_key": { "default": "Alt+Shift+W" },
      "description": "open woodles in the side panel"
    }
  },
  "permissions": ["sidePanel", "contextMenus", "tabs", "storage"],
  "host_permissions": ["https://woodles.space/*"]
}
